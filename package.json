{
  "name": "kalshi-bot-research",
  "version": "0.2.0",
  "packageManager": "bun@1.4.0-canary.1",
  "private": true,
  "description": "Discover and rank public Kalshi trading bots on GitHub (Bun + gh CLI)",
  "type": "module",
  "bin": {
    "tennis-warehouse": "./scripts/warehouse-summary.ts"
  },
  "scripts": {
    "warehouse:summary": "bun scripts/warehouse-summary.ts",
    "tennis:warehouse": "bun scripts/warehouse-summary.ts",
    "research": "bun src/research/cli.ts",
    "research:dry": "bun src/research/cli.ts --dry-run --offline",
    "export-audit": "bun src/research/export-audit-cli.ts",
    "audit:export": "bun src/research/export-audit-cli.ts",
    "serve": "bun --hot src/research/serve.ts",
    "dev": "NODE_ENV=development bun --watch src/research/serve.ts",
    "serve:once": "bun src/research/serve.ts",
    "schedule:register": "bun src/research/schedule-cli.ts register",
    "schedule:remove": "bun src/research/schedule-cli.ts remove",
    "schedule:preview": "bun src/research/schedule-cli.ts preview",
    "agent": "bun src/agent/cli.ts",
    "report:term": "bun src/agent/report-term.ts",
    "report:diff": "bun src/agent/report-term.ts research/reports/latest.diff.md",
    "test": "bun test --isolate --timeout 15000",
    "test:parallel": "bun test --isolate --parallel",
    "test:changed": "bun test --changed",
    "test:watch": "bun test --watch",
    "posttest": "bun tools/restore-committed-artifacts.ts",
    "reports:restore": "bun tools/restore-committed-artifacts.ts",
    "artifacts:restore": "bun tools/restore-committed-artifacts.ts",
    "guard": "bun scripts/audit-bun-native.ts",
    "check": "bun run guard && bun run typecheck && bun run test",
    "rate-limit:status": "bun tools/github-rate-budget.ts",
    "miss-taxonomy:status": "bun tools/miss-taxonomy-status.ts",
    "hooks:install": "cp tools/pre-commit.sh .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit",
    "cache:purge-ineligible": "bun tools/purge-ineligible-runs.ts",
    "train:elo": "bun scripts/train-elo.ts",
    "train:elo:watch": "bun --watch scripts/train-elo.ts",
    "export:toml": "bun scripts/export-toml.ts",
    "research:market-inefficiency": "bun scripts/market-inefficiency.ts",
    "audit:mappings": "bun scripts/audit-mappings.ts",
    "logging:start": "bun scripts/price-logger.ts",
    "logging:once": "bun scripts/price-logger.ts -- --once",
    "logging:filtered": "bun scripts/price-logger.ts -- --filter=",
    "logging:dashboard": "bun scripts/price-logger.ts -- --dashboard",
    "cron:start": "bun scripts/cron-main.ts",
    "cron:once": "bun scripts/cron-main.ts -- --once",
    "logging:status": "bun -e \"import { openEventStore } from './src/institutions/event-store/open-db.ts'; const db = openEventStore({}); const r = db.query('SELECT COUNT(*) as n FROM price_snapshots').get(); console.log('Snapshots:', r.n);\"",
    "test:coverage": "bun test --coverage",
    "typecheck": "tsc --noEmit",
    "alpha:init": "bun src/calibration/init-program.ts",
    "calibration:watcher": "bun src/calibration/cli.ts",
    "calibration:mark-toxicity": "bun src/calibration/mark-toxicity.ts",
    "calibration:resolve-outcomes": "bun src/calibration/resolve-outcomes.ts",
    "calibration:maintenance": "bun src/calibration/maintenance.ts",
    "calibration:toxicity:loop": "bun src/calibration/toxicity-loop.ts",
    "calibration:toxicity:register": "bun src/calibration/toxicity-schedule-cli.ts register",
    "calibration:toxicity:preview": "bun src/calibration/toxicity-schedule-cli.ts preview",
    "alpha:run": "bun src/alpha/run-shadow-once.ts",
    "tennis:events": "bun tools/tennis/events-cli.ts",
    "tennis:itf": "bun tools/tennis/itf-calendar-cli.ts",
    "tennis:tour": "bun tools/tennis/tour-sync-cli.ts",
    "tennis:outcomes": "bun tools/tennis/backfill-outcomes.ts",
    "tennis:record": "bun tools/tennis/record-cli.ts",
    "tennis:ws-ground": "bun tools/tennis/tennis-ws-ground-cli.ts",
    "tennis:collect": "bun tools/tennis/collect-results-cli.ts",
    "tennis:live": "bun tools/tennis/live-scores-cli.ts",
    "tennis:live:canary": "bun tools/tennis/live-scores-cli.ts --canary",
    "tennis:live:canary:register": "bun tools/tennis/live-canary-schedule-cli.ts register",
    "tennis:live:canary:remove": "bun tools/tennis/live-canary-schedule-cli.ts remove",
    "tennis:live:canary:preview": "bun tools/tennis/live-canary-schedule-cli.ts preview",
    "tennis:live:cadence": "bun tools/tennis/live-scores-cli.ts --cadence",
    "tennis:record:ws:register": "bun tools/tennis/ws-recorder-schedule-cli.ts register",
    "tennis:record:ws:remove": "bun tools/tennis/ws-recorder-schedule-cli.ts remove",
    "tennis:record:ws:preview": "bun tools/tennis/ws-recorder-schedule-cli.ts preview",
    "kalshi:rotate-key": "bun tools/kalshi-rotate-key.ts",
    "tennis:experiment": "bun tools/tennis/experiment-cli.ts",
    "tennis:experiment:register": "bun tools/tennis/experiment-schedule-cli.ts register",
    "tennis:experiment:remove": "bun tools/tennis/experiment-schedule-cli.ts remove",
    "tennis:experiment:preview": "bun tools/tennis/experiment-schedule-cli.ts preview",
    "tennis:profiles:build": "bun tools/tennis/build-player-profiles.ts",
    "tennis:profiles:dry": "bun tools/tennis/build-player-profiles.ts --dry-run",
    "regulatory:admin": "bun src/regulatory/scripts/admin.ts",
    "regulatory:migrate": "bun src/regulatory/scripts/migrate.ts",
    "regulatory:sweep": "bun src/regulatory/scripts/sweep-violations.ts",
    "db:generate": "bunx drizzle-kit generate",
    "db:push": "bunx drizzle-kit push",
    "db:studio": "bunx drizzle-kit studio",
    "db:check": "bunx drizzle-kit check",
    "protonpass:check": "bun tools/protonpass-run.ts --env-check",
    "protonpass:run": "bun tools/protonpass-run.ts --",
    "protonpass:health": "bun tools/protonpass-run.ts --health-check",
    "protonpass:mint": "bun tools/protonpass-mint-pat.ts",
    "protonpass:mint:check": "bun tools/protonpass-mint-pat.ts --check",
    "logging:dry": "bun scripts/price-logger.ts -- --dry-run",
    "tennis:profiles:opponents:build": "bun tools/tennis/build-player-opponent-profiles.ts",
    "tennis:profiles:opponents:dry": "bun tools/tennis/build-player-opponent-profiles.ts --dry-run",
    "glossary:check": "bun scripts/check-glossary-usage.ts"
  },
  "engines": {
    "bun": ">=1.4.0-canary.1"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "typescript": "6.0.3"
  }
}
