    "colors:contrast": "bun scripts/check-contrast.ts",
    "colors:bench": "bun scripts/benchmark-color.ts",
    "deps:outdated": "bun scripts/deps-outdated.ts",
    "deps:outdated:latest": "bun scripts/deps-outdated.ts -- --latest",
    "social:meta": "bun -e 'import { extractSocialMetadata } from \"./src/lib/extract-social-meta.ts\"; const u=process.argv[2]||\"https://bun.com\"; console.log(JSON.stringify(await extractSocialMetadata(u),null,2))'",
    "glossary:check": "bun scripts/check-glossary-usage.ts -- --hard",
    "glossary:dump": "bun scripts/dump-glossary.ts",
    "glossary:generate": "bun scripts/generate-glossary-types.ts",
    "partners:validate": "bun scripts/partners-validate.ts",
    "glossary:urls": "bun scripts/validate-glossary-urls.ts",
    "glossary:urls:soft": "bun scripts/validate-glossary-urls.ts -- --soft",
    "glossary:urls:og": "bun scripts/validate-glossary-urls.ts -- --soft --og",
    "glossary:urls:json": "bun scripts/validate-glossary-urls.ts -- --json",
    "health:urls": "bun scripts/validate-glossary-urls.ts -- --json",
    "semantic:audit": "bun scripts/check-glossary-usage.ts -- --hard",
    "glossary:report": "bun scripts/check-glossary-usage.ts -- --report-only",
    "check:liquidity": "bun scripts/check-liquidity.ts",
    "liquidity:recompute": "bun scripts/check-liquidity.ts -- --recompute",
    "liquidity:ground": "bun tools/match-liquidity-ground-cli.ts",
    "liquidity:ground:html": "bun tools/match-liquidity-ground-cli.ts -- --html-only",
    "liquidity:backfill-volume": "bun scripts/backfill-liquidity-volume.ts",
    "liquidity:pipeline": "bun tools/match-liquidity-pipeline-cli.ts",
    "liquidity:pipeline:register": "bun tools/match-liquidity-schedule-cli.ts register",
    "liquidity:pipeline:remove": "bun tools/match-liquidity-schedule-cli.ts remove",
    "liquidity:pipeline:preview": "bun tools/match-liquidity-schedule-cli.ts preview",
    "liquidity:pipeline:watch": "bun --watch tools/match-liquidity-pipeline-cli.ts -- --no-ground",
    "liquidity:ground:watch-db": "bun tools/match-liquidity-db-watch.ts",
    "test:liquidity": "bun test --parallel tests/institutions/match-liquidity.test.ts tests/institutions/match-liquidity-ground.test.ts tests/institutions/match-liquidity-backfill.test.ts tests/institutions/match-liquidity-pipeline.test.ts"
  },
  "engines": {
    "bun": ">=1.3.14"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "typescript": "6.0.3"
  }
}
