# Dependencies & tooling
node_modules/
.bun-cache/
.cache/
coverage/
.DS_Store

# Local secrets (never commit)
.env
.env.*
!.env.example
*.pem
API-KEY.txt
kalshi-bot-*.txt
.protonpass-cache.json

# Machine-local runtime (regenerated each run)
research/cache/
research/outputs/
research/exports/
research/evidence/
research/evidence-captures/
# Local tarball snapshots (research/audit-evidence/*.jsonl is the tracked SSOT)
research/backups/

# Third-party binaries pulled in for reference reading — never source, never tracked
# (research PDFs *are* tracked; only installer images are not)
docs/*.dmg
docs/*.exe
docs/*.zip
docs/*.app/

# Python bytecode from tools/calibration-dashboard.py (the .py itself is tracked)
__pycache__/
*.py[cod]

# Test artifacts (never commit)
tests/.tmp-*

# Host-discover probe dumps (regenerated; keep .gitkeep + deep/ notes)
host-report.json
docs/artifacts/host-discover/*-urls.json

# Alpha tenant runtime (programs committed; logs are not)
alpha/*/shadow-log.jsonl
calibration/artifacts/

# Bun sqlite footgun: `:memory:<name>` is a cwd file, not RAM (use exact `:memory:` or tests/.tmp-*)
:memory:*

# Per-run markdown snapshots (canonical history: cache.db + latest.md)
research/reports/run_*.md
# Auto simplify-loop scan dumps (regenerated by bun run research:simplify)
research/reports/simplify-loop/

# Committed on purpose (do not ignore):
#   research/reports/latest.md
#   research/reports/latest.md.fixture   ← posttest restore SSOT
#   research/reports/latest.diff.md
#   research/reports/latest.diff.md.fixture
#   research/audit-evidence/*.jsonl
#   research/weights.json, keywords.json, schemas/
research/cache/partner-ws-capture/
compare.svg
