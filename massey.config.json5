{
  // Massey pipeline config — Bun.JSON5 (comments + trailing commas allowed).
  sync: {
    sports: ["volleyball", "basketball", "tennis"],
    maxAgeHours: 24, // ratings update ~weekly; skip fresher snapshots
    schedule: "0 3 * * *", // daily 03:00 UTC
