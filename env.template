# Root environment template — resolved via Proton Pass inject
# Usage (from ~/Projects):
#   source scripts/agent-env.sh kalshi-bot
#   bash scripts/proton-inject.sh kalshi-bot
# Or locally: pass-cli inject --in-file env.template --out-file .env --force
#
# Inject syntax requires {{ pass://… }} — see:
#   https://protonpass.github.io/pass-cli/commands/contents/inject/
# Runtime `run` path still uses bare pass:// in .env.protonpass (env-protonpass.template).

# === Kalshi API ===
KALSHI_API_KEY_ID={{ pass://Kalshi Bot/Kalshi API/keyId }}
KALSHI_PRIVATE_KEY={{ pass://Kalshi Bot/Kalshi API/privateKey }}

# === The Odds API ===
ODDS_API_KEY={{ pass://Kalshi Bot/The Odds API/apiKey }}

# === GitHub ===
GH_TOKEN={{ pass://Kalshi Bot/GitHub/token }}

# === Optional gates (uncomment when vault items exist) ===
# KALSHI_ENV={{ pass://Kalshi Bot/Kalshi Environment/env }}
# KALSHI_PROD_ARMED={{ pass://Kalshi Bot/Kalshi Environment/prodArmed }}

# === Fantasy402 Ultra Live (per-out assets) ===
# Pattern: FANTASY402_{CODE}_{N}_*  · vault-out-{CODE}-N  · out-{CODE}-N
# Fallback chain: out → partner (FANTASY402_SPEN_*) → book (FANTASY402_*)
# Keys: BEARER_TOKEN · CUSTOMER_ID · AGENT_ID · PASSWORD · DOMAIN · SKIN · CURRENCY
# Do not paste tokens into shell history; vault inject preferred.
#
# Pass field names: customerID · agentID · password · bearerToken
# SPEN out-1
# FANTASY402_SPEN_1_BEARER_TOKEN={{ pass://Kalshi Bot/Fantasy402 SPEN 1/bearerToken }}
# FANTASY402_SPEN_1_CUSTOMER_ID={{ pass://Kalshi Bot/Fantasy402 SPEN 1/customerID }}
# FANTASY402_SPEN_1_AGENT_ID={{ pass://Kalshi Bot/Fantasy402 SPEN 1/agentID }}
# FANTASY402_SPEN_1_PASSWORD={{ pass://Kalshi Bot/Fantasy402 SPEN 1/password }}
#
# ASH out-1
# FANTASY402_ASH_1_BEARER_TOKEN={{ pass://Kalshi Bot/Fantasy402 ASH 1/bearerToken }}
# FANTASY402_ASH_1_CUSTOMER_ID={{ pass://Kalshi Bot/Fantasy402 ASH 1/customerID }}
# FANTASY402_ASH_1_AGENT_ID={{ pass://Kalshi Bot/Fantasy402 ASH 1/agentID }}
# FANTASY402_ASH_1_PASSWORD={{ pass://Kalshi Bot/Fantasy402 ASH 1/password }}
#
# Legacy book fallback (optional):
# FANTASY402_BEARER_TOKEN={{ pass://Kalshi Bot/Fantasy402/bearerToken }}
# FANTASY402_CUSTOMER_ID={{ pass://Kalshi Bot/Fantasy402/customerID }}

