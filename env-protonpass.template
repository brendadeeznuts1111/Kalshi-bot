# Proton Pass secret references for the Kalshi Bot project.
# Copy to .env.protonpass (gitignored) and adjust vault/item names if yours differ.
# See docs/PROTONPASS.md for setup instructions.
#
# Format (bare URI for `pass-cli run --env-file`):
#   pass://<vault-name>/<item-title>/<field-name>
# Docs:
#   https://protonpass.github.io/pass-cli/commands/contents/secret-references/
#   https://protonpass.github.io/pass-cli/commands/contents/run/
# Note: `pass-cli inject` uses {{ pass://... }} — this file is for `run`, not inject.

# === KALSHI API (REST + WebSocket auth) ===
# Item: "Kalshi API" in your vault
# Fields: keyId, privateKey (inline PEM), privateKeyPath (absolute path)
KALSHI_API_KEY_ID=pass://Kalshi Bot/Kalshi API/keyId
KALSHI_PRIVATE_KEY=pass://Kalshi Bot/Kalshi API/privateKey
# KALSHI_PRIVATE_KEY_PATH=pass://Kalshi Bot/Kalshi API/privateKeyPath

# === THE ODDS API (Pinnacle consensus feed) ===
# Item: "The Odds API" in your vault
# Field: apiKey
ODDS_API_KEY=pass://Kalshi Bot/The Odds API/apiKey

# === GITHUB (rate-limit checks + research pipeline) ===
# Item: "GitHub" in your vault
# Field: token
GH_TOKEN=pass://Kalshi Bot/GitHub/token

# === ENVIRONMENT GATES (optional) ===
# Item: "Kalshi Environment" in your vault
# KALSHI_ENV=pass://Kalshi Bot/Kalshi Environment/env
# KALSHI_PROD_ARMED=pass://Kalshi Bot/Kalshi Environment/prodArmed

# === Fantasy402 Ultra Live (per-out assets) ===
# Pattern: FANTASY402_{CODE}_{N}_{KEY}
# Item titles: "Fantasy402 SPEN 1", "Fantasy402 ASH 1" (one Proton item per out)
# Fallback: out → partner (FANTASY402_SPEN_*) → book (FANTASY402_*)
# Note: Proton vault "partners" / Partner ASH is FactoryWager seat identity — different product.

# --- SPEN out-1 (env_prefix=FANTASY402_SPEN_1_ · vault-out-SPEN-1) ---
FANTASY402_SPEN_1_CUSTOMER_ID=pass://Kalshi Bot/Fantasy402 SPEN 1/customerID
FANTASY402_SPEN_1_AGENT_ID=pass://Kalshi Bot/Fantasy402 SPEN 1/agentID
FANTASY402_SPEN_1_PASSWORD=pass://Kalshi Bot/Fantasy402 SPEN 1/password
FANTASY402_SPEN_1_BEARER_TOKEN=pass://Kalshi Bot/Fantasy402 SPEN 1/bearerToken

# --- ASH out-1 (env_prefix=FANTASY402_ASH_1_ · vault-out-ASH-1) ---
FANTASY402_ASH_1_CUSTOMER_ID=pass://Kalshi Bot/Fantasy402 ASH 1/customerID
FANTASY402_ASH_1_AGENT_ID=pass://Kalshi Bot/Fantasy402 ASH 1/agentID
FANTASY402_ASH_1_PASSWORD=pass://Kalshi Bot/Fantasy402 ASH 1/password
FANTASY402_ASH_1_BEARER_TOKEN=pass://Kalshi Bot/Fantasy402 ASH 1/bearerToken

# --- Legacy book fallback (optional) ---
# FANTASY402_CUSTOMER_ID=pass://Kalshi Bot/Fantasy402/customerID
# FANTASY402_AGENT_ID=pass://Kalshi Bot/Fantasy402/agentID
# FANTASY402_PASSWORD=pass://Kalshi Bot/Fantasy402/password
# FANTASY402_BEARER_TOKEN=pass://Kalshi Bot/Fantasy402/bearerToken

# === RESEARCH PIPELINE (optional non-secret overrides) ===
# These can stay in a plain .env file if you prefer
# RESEARCH_MIN_STARS=5
# RESEARCH_SHORTLIST=12
# PORT=3456
