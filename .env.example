# Kalshi-bot research — copy to .env (gitignored) and adjust locally.
# For ProtonPass secret management, see docs/PROTONPASS.md and env-protonpass.template


# === EXTERNAL API CREDENTIALS (required for live operations) ===

# Kalshi API key for REST + WebSocket auth (RSA-PSS signing)
# Get from: https://kalshi.com/account/api-keys
# KALSHI_API_KEY_ID=your_key_id_here
# KALSHI_PRIVATE_KEY_PATH=/path/to/your/kalshi-private-key.pem
#   — OR inline the PEM directly —
# KALSHI_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvQIBADANBgkqhkiG9w0BAQEFAASCBKcwggSjAgEAAoIBAQC...\n-----END PRIVATE KEY-----"

# The Odds API key for Pinnacle consensus feed
# Get from: https://the-odds-api.com/
# ODDS_API_KEY=your_odds_api_key_here

# GitHub token for rate-limit checks and research pipeline
# Generate: https://github.com/settings/tokens (classic: repo, read:user)
# GH_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
#   — OR use gh CLI: `gh auth login` —

# === ENVIRONMENT GATES ===

# Kalshi client environment: demo (default) or prod
# KALSHI_ENV=demo
# Prod additionally requires:
# KALSHI_PROD_ARMED=1

# === RESEARCH PIPELINE (optional) ===

# Popularity gate overrides
# RESEARCH_MIN_STARS=5
# RESEARCH_MIN_FORKS=3
# RESEARCH_MAX_AGE_MONTHS=18
# RESEARCH_SHORTLIST=12

# Report browser
# PORT=3456

# OS cron (see docs/CRON.md)
# RESEARCH_CRON_SCHEDULE=0 6 * * MON
# RESEARCH_CRON_TITLE=kalshi-research-weekly

# Scheduled runs: export audit when high-value candidates exist
# RESEARCH_EXPORT_AUDIT=1
